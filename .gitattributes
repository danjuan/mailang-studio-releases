* text=auto eol=lf

# Generated diffs encode an empty context line as one significant space.
# Keep other whitespace diagnostics enabled; source-file checks are unchanged.
patches/*.patch whitespace=-blank-at-eol

# Keep the vendored changelog byte-identical to its pinned upstream source.
apps/desktop/resources/plugins/pi.file-manager/CHANGELOG.md whitespace=-blank-at-eol

# Keep the generated OpenReel runtime and view chunks byte-identical to the verified package.
apps/desktop/resources/plugins/local.openreel-proof/main.js whitespace=-blank-at-eol,-space-before-tab
apps/desktop/resources/plugins/local.openreel-proof/views/assets/*.js whitespace=-blank-at-eol,-space-before-tab

# Keep the extracted Media Generation package byte-identical on every platform.
apps/desktop/resources/plugins/local.media-generation/** -text
